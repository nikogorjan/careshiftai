# HubSpot Forms API credentials for the "Keep me posted" form. Both are read
# server side only by app/api/signup/route.ts, so neither reaches the browser.
#
# Find them in HubSpot under Marketing > Forms: the portal id is the account id
# shown in the account menu, and the form id is the GUID in the form's embed
# code (and in the URL while editing the form).
#
# Set these in Vercel (Project Settings -> Environment Variables) and in
# .env.local for local testing. While either is missing the route logs the
# reason and returns an error instead of forwarding the submission.
#
# The HubSpot form must contain these fields, or HubSpot rejects the whole
# submission: firstname, lastname, email, role, handoff_story.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
